# SQLite works without a DATABASE_URL.
# MySQL: create student_progressdb, then add your local credentials in .env.
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/student_progressdb

# Optional: Google Sheets one-way export configuration.
# GOOGLE_SHEET_ID=your_google_spreadsheet_id
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional alternative transport: your own Apps Script must implement the documented
# replace_all JSON contract and validate this shared token before writing to Sheets.
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyVAPMzH6Sqam5d2GuAzySPXMaCZS-NWEg2VkRv6r8Z7HFmK4gdTJcbM9DaT5dFQqsU/exec
# GOOGLE_APPS_SCRIPT_TOKEN=generate_a_long_random_token
